.orch/
modules/
node_modules/
test-packages/

# docs/: whitelist-only. Every markdown doc under docs/ is ignored by default —
# design notes, discussion, run artifacts, red-team reports stay local and never
# reach origin. To publish a specific doc, add an explicit un-ignore (!) below.
docs/*.md
!docs/orch-manual.md
!docs/headless-overnight-design.md
!docs/idea-detach-dashboard-visibility.md
!docs/idea-agent-quota-exclusion.md
# subdir markdown isn't matched by docs/*.md, so ignore internal doc dirs wholesale
docs/superpowers/
tasks/

# stray multi-tool config files (this project is npm-only)
.env
.env.*
*.local
bunfig.toml
.yarnrc
.yarnrc.yml
yarn.lock
pnpm-lock.yaml
.npmrc
.mcp.json
.gitmodules

# home-style dotfiles/dirs that leak into `git status` from a worktree quirk —
# never part of this project; anchored to repo root so they can't hide real files
/.bash_profile
/.bashrc
/.gitconfig
/.profile
/.ripgreprc
/.zprofile
/.zshrc
/.idea
# /scripts/* (not bare /scripts): ignore contents so ! exceptions can re-include
# files. A bare directory pattern excludes the directory entry itself; git then
# never evaluates negations for untracked paths under it (gitignore(5)).
/scripts/*
# Exception: load-bearing security lint (§3g) must stay tracked, not swept by /scripts/*.
!/scripts/lint-token-step.js
# Exception: maintainer release tooling (see npm-publish.yml's header comment).
!/scripts/orch-release.js
# Exception: git-hooks installer, run by npm "prepare" on dev installs.
!/scripts/install-hooks.js
# Exception: invoked by tag-release.yml in CI (#409) — untracked would break the job.
!/scripts/release-tags.js

# Ignore all local VS Code configurations
.vscode/*

# BUT allow sharing of core team configurations if they exist
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/*.code-snippets

# Ignore individual user workspace configurations
*.code-workspace

# Ignore built extensions
*.vsix

# Ignore graphify folder
graphify-out/*
